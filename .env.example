# Backend de reseñas (Supabase) — mismo proyecto que el portfolio.
# Copiar desde Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Video de reseñas (Cloudinary) — cuenta gratuita, sube directo del
# navegador con un upload preset "unsigned" restringido a video/mp4,
# video/quicktime, video/webm y un tamaño máximo.
# Dashboard → Settings → Upload → Upload presets → Add upload preset.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
